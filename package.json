    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ably": "^2.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
